{
  "name": "app-connect",
  "version": "1.0.0",
  "description": "Android app update checker, APK downloader, and APK installer for Expo and React Native CLI apps",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./types-reference": {
      "import": "./dist/types-reference.mjs",
      "require": "./dist/types-reference.js",
      "types": "./dist/types-reference.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "lint": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "expo",
    "react-native",
    "android",
    "app-update",
    "apk",
    "update-checker"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0"
  },
  "peerDependenciesMeta": {
    "expo-file-system": {
      "optional": true
    },
    "expo-intent-launcher": {
      "optional": true
    },
    "expo-linking": {
      "optional": true
    },
    "react-native-fs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/preset-env": "^8.0.5",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^14.2.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.31",
    "@types/react-native": "^0.72.8",
    "babel-jest": "^30.5.1",
    "expo-file-system": "^57.0.6",
    "expo-intent-launcher": "^57.0.1",
    "expo-linking": "^57.0.9",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "^0.87.1",
    "react-test-renderer": "^18.3.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "example-usage.tsx",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  }
}
